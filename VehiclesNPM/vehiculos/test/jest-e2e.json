{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "src/vehiculos/vehiculos\\.controller\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/test/setup/testcontainers-setup.ts",
  "globalTeardown": "<rootDir>/test/setup/testcontainers-teardown.ts",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(jose|jwks-rsa)/)"
  ],
  "testTimeout": 30000
}
